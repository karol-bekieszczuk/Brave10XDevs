{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "evals/**/*.ts"],
  "exclude": ["evals/output/**", "evals/cases/**/base/**", "evals/cases/**/repository/**"]
}
